# User specific IDE config
.idea

# CMake user presets
CMakeUserPresets.json

# Build files
build

# Python bytecode cache, written whenever a scripts/ module is imported
__pycache__/

# Local-only Claude config + content-guard hook (not shared)
.claude/settings.local.json
.claude/hooks/local-content-guard.ps1

# Local-only soak tests read the developer's corpus through environment variables (corpus firewall).
**/tests/test_local_*.cpp
